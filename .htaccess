# ═════════════════════════════════════════════════════════════════
# MOTION MEDIA CIRCLE — Production Apache Configuration (.htaccess)
# Domain: motionmediacircle.com
# ═════════════════════════════════════════════════════════════════

# 1. CHARACTER ENCODING & MIME TYPES
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/html                          .html .htm
  AddType text/css                           .css
  AddType application/javascript             .js .mjs
  AddType application/json                   .json
  AddType image/svg+xml                      .svg .svgz
  AddType image/webp                         .webp
  AddType video/mp4                          .mp4
  AddType font/woff2                         .woff2
  AddType font/woff                          .woff
  AddType font/ttf                           .ttf
  AddType text/xml application/xml           .xml
  AddType text/plain                         .txt
</IfModule>

# 2. REWRITE ENGINE & CLEAN URLS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2.1 Force HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.motionmediacircle\.com$ [NC]
  RewriteRule ^(.*)$ https://motionmediacircle.com/$1 [R=301,L]

  # 2.2 Redirect /index.html and /index to root /
  RewriteCond %{THE_REQUEST} \s/index(?:\.html)?[\s?] [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,L]

  # 2.3 Redirect direct *.html requests to clean URLs (e.g. /services.html -> /services)
  RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # 2.4 Alias /llm.txt to /llms.txt
  RewriteRule ^llm\.txt$ llms.txt [L]

  # 2.5 Internally rewrite clean URLs to corresponding .html files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # 2.6 Trailing slash normalization for directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# 3. CUSTOM ERROR PAGES
ErrorDocument 404 /404.html

# 4. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSER CACHING (EXPIRES & CACHE-CONTROL)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                               "access plus 1 month"

  # HTML & Feeds (revalidate often)
  ExpiresByType text/html                      "access plus 0 seconds"
  ExpiresByType application/xhtml+xml          "access plus 0 seconds"
  ExpiresByType text/xml                       "access plus 0 seconds"
  ExpiresByType application/xml                "access plus 0 seconds"
  ExpiresByType application/json               "access plus 0 seconds"
  ExpiresByType text/plain                     "access plus 1 hour"

  # CSS & JS
  ExpiresByType text/css                       "access plus 1 month"
  ExpiresByType application/javascript         "access plus 1 month"
  ExpiresByType application/x-javascript       "access plus 1 month"

  # Media (Images, Video, Audio)
  ExpiresByType image/jpg                      "access plus 1 year"
  ExpiresByType image/jpeg                     "access plus 1 year"
  ExpiresByType image/gif                      "access plus 1 year"
  ExpiresByType image/png                      "access plus 1 year"
  ExpiresByType image/webp                     "access plus 1 year"
  ExpiresByType image/svg+xml                  "access plus 1 year"
  ExpiresByType image/x-icon                   "access plus 1 year"
  ExpiresByType video/mp4                      "access plus 1 year"
  ExpiresByType video/webm                     "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf                       "access plus 1 year"
  ExpiresByType font/otf                       "access plus 1 year"
  ExpiresByType font/woff                      "access plus 1 year"
  ExpiresByType font/woff2                     "access plus 1 year"
  ExpiresByType application/font-woff2         "access plus 1 year"
</IfModule>

# 6. SECURITY & PRIVACY HEADERS
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Protect against clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # XSS filter protection
  Header set X-XSS-Protection "1; mode=block"

  # Control Referrer information
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized browser features
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Cache-Control for static assets
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|mp4|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Do not cache HTML / XML / JSON
  <FilesMatch "\.(html|htm|xml|json)$">
    Header set Cache-Control "max-age=0, private, no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 7. SENSITIVE FILE & DIRECTORY PROTECTION
# Block access to hidden files (.git, .DS_Store, etc.) and repo metadata
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|env|md|git.*)$|CNAME)">
  Require all denied
</FilesMatch>

# Allow public access to .well-known
<IfModule mod_rewrite.c>
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes -MultiViews
